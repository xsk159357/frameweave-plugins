{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/analyze_basic",
  "title": "普通模式视频分析（A9）",
  "category": "分析",
  "description": "video_pipeline 普通模式：中间帧批 15 图/并发 5 简化视觉分析 → description_items（无分块语义，与 core/analyze_chunks 区分）",
  "version": "1.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "AnalyzeBasicNode",
  "inputs": [
    {
      "name": "video",
      "type": "VIDEO",
      "label": "视频",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "输入视频资产（中间帧采样来源）"
    }
  ],
  "outputs": [
    {
      "name": "description_items",
      "type": "JSON",
      "label": "描述条目",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "中间帧批简化视觉分析结果（items: {index,time_start,time_end,shot_type,visual_description,audio_content}）"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "分析报告",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "批/并发参数生效记录、耗时、警告"
    }
  ],
  "params": [
    {
      "name": "provider",
      "type": "STRING",
      "label": "Provider",
      "required": true,
      "default": "auto",
      "widget": "select",
      "options": [
        "auto",
        "openai",
        "gemini"
      ],
      "description": "auto=按 base_url 识别（generativelanguage → gemini）"
    },
    {
      "name": "api_key",
      "type": "STRING",
      "label": "API Key",
      "required": false,
      "default": "",
      "widget": "password",
      "options": [],
      "description": "支持 @secret:名称 引用保险箱"
    },
    {
      "name": "base_url",
      "type": "STRING",
      "label": "API 地址",
      "required": false,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "留空按 provider 默认（OpenAI / Gemini）"
    },
    {
      "name": "model",
      "type": "STRING",
      "label": "视觉模型",
      "required": true,
      "default": "gemini-1.5-flash",
      "widget": "text",
      "options": [],
      "description": "支持视觉输入的模型"
    },
    {
      "name": "frame_batch",
      "type": "INT",
      "label": "中间帧批数",
      "required": true,
      "default": 15,
      "widget": "number",
      "options": [],
      "description": "整片采样中间帧总数（普通模式批 15 语义）"
    },
    {
      "name": "frames_per_group",
      "type": "INT",
      "label": "每组帧数",
      "required": true,
      "default": 5,
      "widget": "number",
      "options": [],
      "description": "每次视觉调用携带的帧数（帧分组粒度）"
    },
    {
      "name": "concurrency",
      "type": "INT",
      "label": "并发数",
      "required": true,
      "default": 5,
      "widget": "number",
      "options": [],
      "description": "并行视觉调用上限（普通模式并发 5 语义）"
    },
    {
      "name": "retries",
      "type": "INT",
      "label": "重试次数",
      "required": true,
      "default": 2,
      "widget": "number",
      "options": [],
      "description": "解析/schema/网络失败重试次数"
    },
    {
      "name": "frame_scale",
      "type": "INT",
      "label": "帧宽(px)",
      "required": true,
      "default": 448,
      "widget": "number",
      "options": [],
      "description": "抽帧缩放宽边（控制视觉 Token 成本）"
    },
    {
      "name": "temperature",
      "type": "FLOAT",
      "label": "温度",
      "required": true,
      "default": 0.2,
      "widget": "number",
      "options": [],
      "description": ""
    },
    {
      "name": "max_tokens",
      "type": "INT",
      "label": "最大 Token",
      "required": true,
      "default": 1024,
      "widget": "number",
      "options": [],
      "description": ""
    }
  ],
  "permission": {
    "subprocess": {
      "enabled": true,
      "argv_allowlist": [
        "ffmpeg",
        "ffmpeg.exe",
        "ffprobe",
        "ffprobe.exe"
      ]
    },
    "secret": {
      "refs": [
        "*"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "vuOdv88BORpFtPRUCSQqiDIivsA6gydLol7U/010wKr0ZLZUTLULrQIUm1IGZ3T8/ILS3vpVtALqHnNh7P8+Dg==",
    "over": "manifest"
  }
}