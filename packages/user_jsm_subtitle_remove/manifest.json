{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "user/jsm_subtitle_remove",
  "title": "去字幕(轻量)",
  "category": "剪辑",
  "description": "画面字幕区域裁剪放大回填去字幕（bottom/top/both，轻量滤镜版，不依赖模型中心）",
  "version": "1.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "JsmSubtitleRemoveNode",
  "inputs": [
    {
      "name": "video",
      "type": "VIDEO",
      "label": "源视频",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "待去字幕视频"
    }
  ],
  "outputs": [
    {
      "name": "video_out",
      "type": "VIDEO",
      "label": "去字幕视频",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "去字幕后的视频资产"
    },
    {
      "name": "stats",
      "type": "JSON",
      "label": "处理报告",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "区域/比例/耗时"
    }
  ],
  "params": [
    {
      "name": "region",
      "type": "STRING",
      "label": "字幕区域",
      "required": true,
      "default": "bottom",
      "widget": "select",
      "options": [
        "bottom",
        "top",
        "both"
      ],
      "description": "bottom=底部字幕；top=顶部；both=上下各裁一半"
    },
    {
      "name": "region_ratio",
      "type": "FLOAT",
      "label": "区域比例(0-0.5)",
      "required": true,
      "default": 0.2,
      "widget": "number",
      "options": [],
      "description": "裁剪区域占画面高的比例（默认 0.20=20%）"
    },
    {
      "name": "output_name",
      "type": "STRING",
      "label": "输出文件名",
      "required": true,
      "default": "no_sub",
      "widget": "text",
      "options": [],
      "description": ""
    }
  ],
  "permission": {
    "subprocess": {
      "enabled": true,
      "argv_allowlist": [
        "ffmpeg",
        "ffmpeg.exe",
        "ffprobe",
        "ffprobe.exe"
      ]
    },
    "fs": {
      "write": [
        "jsm_subtitle_remove/**",
        "assets/**"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "XPDZ8oNIaw7EcAhEWcULZO9mQYFsTobLLtifa04GNz7ymVjHTwb9NX9ltjiYEqWiFoJxpviDZPnfvVZ/qjxZAA==",
    "over": "manifest"
  }
}