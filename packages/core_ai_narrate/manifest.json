{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/ai_narrate",
  "title": "AI 文案生成",
  "category": "语义",
  "description": "解说文案：上帝视角（视频/场景/描述）· 扩写 · 配画面 · 仿写；OpenAI/Gemini 兼容",
  "version": "2.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "AINarrateNode",
  "inputs": [
    {
      "name": "video",
      "type": "VIDEO",
      "label": "视频",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "上帝视角关键帧来源"
    },
    {
      "name": "scenes",
      "type": "SEGMENTS",
      "label": "场景片段",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "场景列表（配画面/时间戳本地匹配用）"
    },
    {
      "name": "descriptions",
      "type": "JSON",
      "label": "场景描述",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "分块视觉分析的场景描述（上帝视角免关键帧、省 Token）"
    },
    {
      "name": "draft",
      "type": "SCRIPT",
      "label": "文案草稿/示例",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "扩写草稿 / 配画面文案 / 仿写示例"
    }
  ],
  "outputs": [
    {
      "name": "script",
      "type": "SCRIPT",
      "label": "解说文案",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "最终文案（text/chars/duration_estimate）"
    },
    {
      "name": "narration",
      "type": "JSON",
      "label": "结构化文案",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "分段 {text,start,end,scene_ids,tts_duration} + 覆盖率"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "生成报告",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "provider/model/策略/警告"
    }
  ],
  "params": [
    {
      "name": "mode",
      "type": "STRING",
      "label": "模式",
      "required": true,
      "default": "上帝视角",
      "widget": "select",
      "options": [
        "上帝视角",
        "扩写",
        "配画面",
        "仿写"
      ],
      "description": ""
    },
    {
      "name": "style",
      "type": "STRING",
      "label": "风格",
      "required": true,
      "default": "悬疑解说",
      "widget": "select",
      "options": [
        "悬疑解说",
        "搞笑解说",
        "知识科普",
        "情感讲述",
        "客观平实",
        "自定义"
      ],
      "description": "内置风格包（钩子/禁词/语速）"
    },
    {
      "name": "custom_style",
      "type": "STRING",
      "label": "自定义风格描述",
      "required": false,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "style=自定义 时的角色/语气描述"
    },
    {
      "name": "perspective",
      "type": "STRING",
      "label": "视角",
      "required": true,
      "default": "第三人称",
      "widget": "select",
      "options": [
        "第三人称",
        "第一人称"
      ],
      "description": ""
    },
    {
      "name": "language",
      "type": "STRING",
      "label": "语言",
      "required": true,
      "default": "中文",
      "widget": "select",
      "options": [
        "中文",
        "英语",
        "日语",
        "韩语",
        "泰语",
        "越南语",
        "自动"
      ],
      "description": ""
    },
    {
      "name": "provider",
      "type": "STRING",
      "label": "Provider",
      "required": true,
      "default": "auto",
      "widget": "select",
      "options": [
        "auto",
        "openai",
        "gemini"
      ],
      "description": "auto=按 base_url 识别（generativelanguage → gemini）"
    },
    {
      "name": "api_key",
      "type": "STRING",
      "label": "API Key",
      "required": false,
      "default": "",
      "widget": "password",
      "options": [],
      "description": "支持 @secret:名称 引用保险箱"
    },
    {
      "name": "base_url",
      "type": "STRING",
      "label": "API 地址",
      "required": false,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "留空按 provider 默认（OpenAI / Gemini）"
    },
    {
      "name": "model",
      "type": "STRING",
      "label": "模型",
      "required": true,
      "default": "gpt-4o",
      "widget": "text",
      "options": [],
      "description": ""
    },
    {
      "name": "target_duration",
      "type": "FLOAT",
      "label": "目标时长(秒,0=自动)",
      "required": true,
      "default": 0,
      "widget": "number",
      "options": [],
      "description": "0=按视频时长 80% 自动推算"
    },
    {
      "name": "target_chars",
      "type": "INT",
      "label": "目标字数(0=自动)",
      "required": true,
      "default": 0,
      "widget": "number",
      "options": [],
      "description": "0=时长 × 4.5 字/秒 自动推算"
    },
    {
      "name": "avg_segment_chars",
      "type": "INT",
      "label": "平均每段字数",
      "required": true,
      "default": 25,
      "widget": "number",
      "options": [],
      "description": "估算分段数用"
    },
    {
      "name": "temperature",
      "type": "FLOAT",
      "label": "温度",
      "required": true,
      "default": 0.7,
      "widget": "number",
      "options": [],
      "description": ""
    },
    {
      "name": "max_tokens",
      "type": "INT",
      "label": "最大 Token",
      "required": true,
      "default": 4096,
      "widget": "number",
      "options": [],
      "description": ""
    },
    {
      "name": "keyframes",
      "type": "INT",
      "label": "关键帧数",
      "required": true,
      "default": 8,
      "widget": "number",
      "options": [],
      "description": "上帝视角无描述时的抽帧数量"
    },
    {
      "name": "json_mode",
      "type": "BOOL",
      "label": "结构化输出",
      "required": true,
      "default": true,
      "widget": "toggle",
      "options": [],
      "description": "要求 LLM 输出 JSON 分段，失败回退纯文本"
    },
    {
      "name": "local_match",
      "type": "BOOL",
      "label": "本地匹配兜底",
      "required": true,
      "default": true,
      "widget": "toggle",
      "options": [],
      "description": "零 Token 本地场景匹配（顺序消费/全局去重/超长后扩）"
    },
    {
      "name": "retries",
      "type": "INT",
      "label": "重试次数",
      "required": true,
      "default": 2,
      "widget": "number",
      "options": [],
      "description": "LLM 请求失败重试次数"
    }
  ],
  "permission": {
    "subprocess": {
      "enabled": true,
      "argv_allowlist": [
        "ffmpeg",
        "ffmpeg.exe"
      ]
    },
    "secret": {
      "refs": [
        "*"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "AZARsZznMVFtHqdt/ToKGz/A9qvkNEVorgbWP1vveXW5iPSr3IN5135KyEjuNVBcP4kC54drcXKjmfzilRSLCg==",
    "over": "manifest"
  }
}