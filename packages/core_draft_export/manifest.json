{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/draft_export",
  "title": "剪映草稿导出",
  "category": "输出",
  "description": "生成剪映草稿目录（完整 27 键结构）+ Premiere XML/EDL/FCPXML + SRT；字幕样式、画幅、导出目标可选。",
  "version": "1.1.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "DraftExportNode",
  "inputs": [
    {
      "name": "video",
      "type": "VIDEO",
      "label": "视频",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "源视频资产"
    },
    {
      "name": "segments",
      "type": "SEGMENTS",
      "label": "片段列表",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "split_cam 风格片段列表"
    },
    {
      "name": "audio",
      "type": "AUDIO",
      "label": "配音音频",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "合并解说音频（未给 voice_items 时整段一轨）"
    },
    {
      "name": "styled_subtitle",
      "type": "SUBTITLE",
      "label": "样式字幕",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "字幕列表（含 style）"
    },
    {
      "name": "timeline",
      "type": "TIMELINE",
      "label": "时间线",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "时间线资产：{segments, voice_items:[{segment_index,path,duration,start,end}]}"
    },
    {
      "name": "bgm",
      "type": "AUDIO",
      "label": "背景音乐",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "循环铺满的 BGM 轨"
    }
  ],
  "outputs": [
    {
      "name": "draft",
      "type": "JSON",
      "label": "剪映草稿信息",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "草稿目录与结构摘要"
    },
    {
      "name": "xml",
      "type": "STRING",
      "label": "Pr XML",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "xmeml v4 XML 文本"
    },
    {
      "name": "edl",
      "type": "STRING",
      "label": "EDL",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "CMX 3600 EDL 文本"
    },
    {
      "name": "fcpxml",
      "type": "STRING",
      "label": "FCPXML",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "FCPXML 1.9 文本"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "导出报告",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "导出报告（文件路径/统计）"
    }
  ],
  "params": [
    {
      "name": "format",
      "type": "STRING",
      "label": "导出格式",
      "required": true,
      "default": "jianying",
      "widget": "select",
      "options": [
        "jianying",
        "prxml",
        "edl",
        "fcpxml",
        "all"
      ],
      "description": ""
    },
    {
      "name": "aspect",
      "type": "STRING",
      "label": "画幅",
      "required": true,
      "default": "16:9",
      "widget": "select",
      "options": [
        "16:9",
        "9:16",
        "1:1"
      ],
      "description": ""
    },
    {
      "name": "resolution",
      "type": "STRING",
      "label": "分辨率",
      "required": true,
      "default": "1080p",
      "widget": "select",
      "options": [
        "1080p",
        "720p",
        "4k"
      ],
      "description": ""
    },
    {
      "name": "canvas_ratio",
      "type": "STRING",
      "label": "画布比例",
      "required": true,
      "default": "original",
      "widget": "select",
      "options": [
        "original",
        "16:9",
        "9:16",
        "1:1"
      ],
      "description": "original=跟随源视频尺寸（r4 默认）"
    },
    {
      "name": "draft_name",
      "type": "STRING",
      "label": "草稿名",
      "required": true,
      "default": "FrameWeave_导出",
      "widget": "text",
      "options": [],
      "description": ""
    },
    {
      "name": "export_target",
      "type": "STRING",
      "label": "导出目标",
      "required": true,
      "default": "jianying",
      "widget": "select",
      "options": [
        "jianying",
        "capcut"
      ],
      "description": "剪映国内版或 CapCut 国际版"
    },
    {
      "name": "subtitle_style",
      "type": "STRING",
      "label": "字幕样式",
      "required": true,
      "default": "经典-白字黑边",
      "widget": "select",
      "options": [
        "经典-白字黑边",
        "黑底白字",
        "黄字红边",
        "默认"
      ],
      "description": ""
    },
    {
      "name": "font_size",
      "type": "FLOAT",
      "label": "字号",
      "required": true,
      "default": 0.0,
      "widget": "number",
      "options": [],
      "description": "0=横版6/竖版9"
    },
    {
      "name": "enable_subtitle",
      "type": "BOOL",
      "label": "生成字幕",
      "required": true,
      "default": true,
      "widget": "toggle",
      "options": [],
      "description": ""
    },
    {
      "name": "fps",
      "type": "INT",
      "label": "工程帧率",
      "required": true,
      "default": 30,
      "widget": "number",
      "options": [],
      "description": "XML/EDL 帧换算帧率"
    },
    {
      "name": "output_dir",
      "type": "STRING",
      "label": "输出目录",
      "required": true,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "留空输出到资产目录"
    }
  ],
  "permission": {
    "subprocess": {
      "enabled": true,
      "argv_allowlist": [
        "ffprobe"
      ]
    },
    "fs": {
      "write": [
        "drafts/**",
        "assets/**"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "DtZacxQosDK84ISD47Gs2HxwpRF7E4HrfzU1jyLYnKygb/yNUEurBShn4Ye5l49uNw3RjGcGIgmcmENru1XQDg==",
    "over": "manifest"
  }
}