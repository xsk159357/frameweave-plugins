{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/plan_to_outline",
  "title": "选材大纲转换",
  "category": "语义",
  "description": "把选材计划（片段+章节+引导）渲染成文案节点可消费的大纲文本；解决 plan JSON 不能直接进文案口的问题",
  "version": "1.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "PlanToOutlineNode",
  "inputs": [
    {
      "name": "plan",
      "type": "JSON",
      "label": "选材计划",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "user/jsm_highlight_plan 的 plan 输出"
    }
  ],
  "outputs": [
    {
      "name": "outline",
      "type": "SCRIPT",
      "label": "大纲文本",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "可直连 ai_narrate 的 draft 口"
    },
    {
      "name": "segments",
      "type": "SEGMENTS",
      "label": "选材片段表",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "plan.items 摊平成源片区间，可直接接 timeline_to_segments.base"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "转换报告",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "段数/章节数/素材时长/是否截断/选材来源"
    }
  ],
  "params": [
    {
      "name": "format",
      "type": "STRING",
      "label": "大纲格式",
      "required": true,
      "default": "chapter",
      "widget": "select",
      "options": [
        "chapter",
        "bullet",
        "narrative"
      ],
      "description": "chapter=按章节分组；bullet=平铺要点；narrative=叙述式"
    },
    {
      "name": "max_chars",
      "type": "INT",
      "label": "大纲最长字数",
      "required": true,
      "default": 1200,
      "widget": "number",
      "options": [],
      "description": "超出截断，避免把提示词撑爆"
    },
    {
      "name": "hook_hint",
      "type": "STRING",
      "label": "开场钩子方向",
      "required": true,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "留空则只给通用要求"
    }
  ],
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "Ls/C66rju7RIhrQx/FrLw5CUqbJBXJCcs6LptgY5LicZHhws2HiHLNVWbkOwKlsTkYDsCx07IyEWNDD54uuxDQ==",
    "over": "manifest"
  }
}