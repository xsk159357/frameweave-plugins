{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/sse_reader",
  "title": "SSE 流读取",
  "category": "输入",
  "description": "读取 OpenAI/Google 两种 SSE 流：text/事件/报告输出；0.2s 节流；可重试、可中断",
  "version": "1.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "SseReaderNode",
  "inputs": [],
  "outputs": [
    {
      "name": "text",
      "type": "STRING",
      "label": "聚合文本",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "全文拼接结果"
    },
    {
      "name": "events",
      "type": "JSON",
      "label": "事件流",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "逐事件记录（delta/total_chars/ts）"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "读取报告",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "format/done/partial/interrupted/retries/节流"
    }
  ],
  "params": [
    {
      "name": "endpoint",
      "type": "STRING",
      "label": "请求地址",
      "required": true,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "SSE 流式接口地址"
    },
    {
      "name": "method",
      "type": "STRING",
      "label": "方法",
      "required": true,
      "default": "POST",
      "widget": "select",
      "options": [
        "POST",
        "GET"
      ],
      "description": ""
    },
    {
      "name": "payload",
      "type": "STRING",
      "label": "请求体(JSON)",
      "required": false,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "POST 请求体；留空发送空体"
    },
    {
      "name": "headers",
      "type": "STRING",
      "label": "请求头(JSON)",
      "required": false,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "例 {\"Content-Type\": \"application/json\"}"
    },
    {
      "name": "api_key",
      "type": "STRING",
      "label": "API Key",
      "required": false,
      "default": "",
      "widget": "password",
      "options": [],
      "description": "支持 @secret:名称；自动加 Authorization: Bearer"
    },
    {
      "name": "format",
      "type": "STRING",
      "label": "SSE 格式",
      "required": true,
      "default": "auto",
      "widget": "select",
      "options": [
        "auto",
        "openai",
        "google"
      ],
      "description": "auto=按响应形状自动识别"
    },
    {
      "name": "throttle_seconds",
      "type": "FLOAT",
      "label": "节流间隔(秒)",
      "required": true,
      "default": 0.2,
      "widget": "number",
      "options": [],
      "description": "参考语义 0.2s：推送/progress 触发最小间隔"
    },
    {
      "name": "stream_timeout",
      "type": "INT",
      "label": "流超时(秒)",
      "required": true,
      "default": 120,
      "widget": "number",
      "options": [],
      "description": ""
    },
    {
      "name": "retries",
      "type": "INT",
      "label": "重试次数",
      "required": true,
      "default": 2,
      "widget": "number",
      "options": [],
      "description": "仅未收到任何内容时的连接级重试（部分内容不重试）"
    },
    {
      "name": "retry_delay",
      "type": "FLOAT",
      "label": "重试间隔(秒)",
      "required": true,
      "default": 1.5,
      "widget": "number",
      "options": [],
      "description": ""
    }
  ],
  "permission": {
    "secret": {
      "refs": [
        "*"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "/uzQ2DkXbvNKh5GgEpeXasE+fHxuoIGdKOKy37DzwU+XoHBJtUC/+a+/X/XRiZXwItmeWTpLz0XWvgeRqgUDDA==",
    "over": "manifest"
  }
}