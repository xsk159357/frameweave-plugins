{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "user/jsm_script_doctor",
  "title": "脚本医生·文案质检",
  "category": "语义",
  "description": "解说文案 6 维深度质检 + 12 项硬指标 + 3 套全文改写方案 + 结论等级。本地规则引擎离线可用（不绑定授权、不依赖 RAG 服务）；配置 API Key 时 LLM 增强润色。批量可用。",
  "version": "1.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "ScriptDoctorNode",
  "inputs": [
    {
      "name": "script",
      "type": "SCRIPT",
      "label": "待检文案",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "文案正文；与 items 二选一"
    },
    {
      "name": "items",
      "type": "JSON",
      "label": "批量条目",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "标准批次信封；每项 input={text:...} 或 {script_text:...}"
    }
  ],
  "outputs": [
    {
      "name": "diagnosis",
      "type": "JSON",
      "label": "质检报告",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "6 维评分 + 12 硬指标 + 问题/优势/差距 + 结论等级"
    },
    {
      "name": "rewrites",
      "type": "JSON",
      "label": "改写方案",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "3 套全文改写方案 [{id,title,text,diff}]"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "执行报告",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "引擎模式（local/llm）/统计/批处理结果"
    },
    {
      "name": "results",
      "type": "JSON",
      "label": "批量结果",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "标准批次信封（单条=1 项，批量=多项）"
    }
  ],
  "params": [
    {
      "name": "min_length",
      "type": "INT",
      "label": "最小字数",
      "required": true,
      "default": 20,
      "widget": "number",
      "options": [],
      "description": "低于该字数直接判需大幅改进"
    },
    {
      "name": "api_key",
      "type": "STRING",
      "label": "API Key",
      "required": false,
      "default": "",
      "widget": "password",
      "options": [],
      "description": "可选；填写则 LLM 增强润色（3 套改写由模型生成）"
    },
    {
      "name": "base_url",
      "type": "STRING",
      "label": "中转地址",
      "required": true,
      "default": "https://ameaaos.com/v1",
      "widget": "text",
      "options": [],
      "description": "OpenAI 兼容 base（含 /v1）"
    },
    {
      "name": "model",
      "type": "STRING",
      "label": "模型",
      "required": true,
      "default": "gpt-4o",
      "widget": "text",
      "options": [],
      "description": ""
    },
    {
      "name": "rewrite_count",
      "type": "INT",
      "label": "改写方案数",
      "required": true,
      "default": 3,
      "widget": "number",
      "options": [],
      "description": "1~3 套"
    },
    {
      "name": "max_concurrent",
      "type": "INT",
      "label": "批量并发",
      "required": true,
      "default": 2,
      "widget": "number",
      "options": [],
      "description": ""
    },
    {
      "name": "retries",
      "type": "INT",
      "label": "重试次数",
      "required": true,
      "default": 1,
      "widget": "number",
      "options": [],
      "description": ""
    },
    {
      "name": "resume",
      "type": "BOOL",
      "label": "断点续跑",
      "required": true,
      "default": true,
      "widget": "toggle",
      "options": [],
      "description": ""
    }
  ],
  "permission": {
    "network": {
      "allow": [
        "*"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "DgnITwNog9/7Vpt6TtGUSfyyb9IHGS8aaEUwF/GyPI3JLjd8g97amDrVNHxwb018PETJ9dpPFe9eTdbhYEtyBQ==",
    "over": "manifest"
  }
}