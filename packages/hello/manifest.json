{
  "type_id": "user/hello",
  "title": "问候生成",
  "category": "用户节点",
  "description": "声明式示例节点：拼接问候语",
  "version": "1.0.0",
  "kind": "transform",
  "inputs": [
    {
      "name": "name",
      "type": "STRING",
      "label": "名字",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "greeting",
      "type": "STRING",
      "label": "问候语"
    },
    {
      "name": "length",
      "type": "INT",
      "label": "长度"
    }
  ],
  "params": [
    {
      "name": "prefix",
      "type": "STRING",
      "default": "你好",
      "label": "前缀"
    }
  ],
  "transform": {
    "greeting": {
      "op": "concat",
      "sources": [
        {
          "$param": "prefix"
        },
        {
          "$input": "name"
        }
      ],
      "sep": "，",
      "suffix": "！"
    },
    "length": {
      "op": "len",
      "source": {
        "$input": "name"
      }
    }
  }
}