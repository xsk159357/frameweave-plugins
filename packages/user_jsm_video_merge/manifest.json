{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "user/jsm_video_merge",
  "title": "视频合并/拼接",
  "category": "剪辑",
  "description": "多视频拼接（concat）或视频+音频合并（mix/mux）；videos 传 JSON 数组/信封，输出合成视频与报告",
  "version": "1.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "JsmVideoMergeNode",
  "inputs": [
    {
      "name": "videos",
      "type": "JSON",
      "label": "视频列表(JSON)",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "数组：路径字符串或 {path,name}；或 {items:[...]} 信封；concat 需≥2 条"
    },
    {
      "name": "audio",
      "type": "AUDIO",
      "label": "外部音频(可选)",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "mix/mux 模式的合并音轨（concat 忽略）"
    }
  ],
  "outputs": [
    {
      "name": "video_out",
      "type": "VIDEO",
      "label": "合成视频",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "合并/拼接完成的视频资产"
    },
    {
      "name": "stats",
      "type": "JSON",
      "label": "合并报告",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "模式/源列表/输出大小/耗时"
    }
  ],
  "params": [
    {
      "name": "mode",
      "type": "STRING",
      "label": "合并模式",
      "required": true,
      "default": "concat",
      "widget": "select",
      "options": [
        "concat",
        "mix",
        "mux"
      ],
      "description": "concat=多视频拼接；mix=视频+外部音频重编码混音；mux=流拷贝封装"
    },
    {
      "name": "width",
      "type": "INT",
      "label": "统一宽度(0=源)",
      "required": false,
      "default": 0,
      "widget": "number",
      "options": [],
      "description": "concat 统一输出宽度；0=第一个视频宽度"
    },
    {
      "name": "fps",
      "type": "INT",
      "label": "统一帧率(0=源)",
      "required": false,
      "default": 0,
      "widget": "number",
      "options": [],
      "description": "concat 统一输出帧率；0=第一个视频帧率"
    },
    {
      "name": "output_name",
      "type": "STRING",
      "label": "输出文件名",
      "required": true,
      "default": "merged",
      "widget": "text",
      "options": [],
      "description": ""
    }
  ],
  "permission": {
    "subprocess": {
      "enabled": true,
      "argv_allowlist": [
        "ffmpeg",
        "ffmpeg.exe"
      ]
    },
    "fs": {
      "write": [
        "jsm_video_merge/**",
        "assets/**"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "tGV+Em3YTZ1TogZjzpPxOo7XrxqvBR3WwTKPbOWgRUQSf9m/rIx1IjiRDoSbAPJesKf05IWQcmOuGs/V7xXICQ==",
    "over": "manifest"
  }
}