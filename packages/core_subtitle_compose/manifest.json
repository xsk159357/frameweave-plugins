    {
      "name": "stroke",
      "type": "STRING",
      "label": "描边色",
      "required": true,
      "default": "#000000",
      "widget": "text",
      "options": [],
      "description": ""
    },
    {
      "name": "animation",
      "type": "STRING",
      "label": "动画",
      "required": true,
      "default": "none",
      "widget": "select",
      "options": [
        "none",
        "typewriter",
        "bounce",
        "fade",
        "fadeup"
      ],
      "description": ""
    },
    {
      "name": "karaoke",
      "type": "BOOL",
      "label": "逐字卡点",
      "required": true,
      "default": true,
      "widget": "text",
      "options": [],
      "description": ""
    }
  ],
