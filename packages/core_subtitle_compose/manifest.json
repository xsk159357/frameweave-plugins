      "label": "样式化字幕",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": ""
    }
  ],
  "params": [
    {
      "name": "manual_text",
      "type": "STRING",
      "label": "手动字幕",
      "required": true,
      "default": "",
