{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/subtitle_compose",
  "title": "字幕装配",
  "category": "输出",
  "description": "字幕高级样式：花字/特效/逐句卡点动画",
  "version": "1.0.0",
