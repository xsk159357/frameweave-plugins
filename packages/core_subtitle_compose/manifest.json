      "name": "font",
      "type": "STRING",
      "label": "字体",
      "required": true,
      "default": "微软雅黑",
      "widget": "text",
      "options": [],
      "description": ""
    },
    {
      "name": "size",
      "type": "INT",
      "label": "字号",
      "required": true,
      "default": 48,
      "widget": "number",
      "options": [],
      "description": ""
