{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/mixed_audio_layout",
  "title": "双轨混音布局",
  "category": "剪辑",
  "description": "B7：解说轨+原声轨互斥静音布局（±50ms 斜坡），原声裁剪（padding 0.05/0.1），输出可导入剪映/渲染",
  "version": "1.0.3",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "MixedAudioLayoutNode",
  "inputs": [
    {
      "name": "rich_scenes",
      "type": "JSON",
      "label": "富场景(已决策)",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "B6 输出：dialogues 含 keep 标记"
    },
    {
      "name": "narration_items",
      "type": "JSON",
      "label": "解说片段",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "解说时间线 [{segment_index,text,start,end}]（ai_narrate narration 输出）"
    },
    {
      "name": "narration_marks",
      "type": "JSON",
      "label": "TTS 时间戳(marks)",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "core/tts marks 输出 {segments:[{start,duration,...}]}；提供时其 per-segment duration 优先于 narration_items 的窗口/估算值"
    }
  ],
  "outputs": [
    {
      "name": "layout",
      "type": "JSON",
      "label": "混音布局",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "{schema_version,ramp_ms,narration_track,original_track,narration_mute_ranges,original_mute_ranges,original_clips,stats}"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "布局报告",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "互斥区间/统计/斜坡说明"
    }
  ],
  "params": [
    {
      "name": "padding_before",
      "type": "FLOAT",
      "label": "原声入点padding(秒)",
      "required": true,
      "default": 0.05,
      "widget": "number",
      "options": [],
      "description": "原声裁剪入点=对话start-padding_before"
    },
    {
      "name": "padding_after",
      "type": "FLOAT",
      "label": "原声出点padding(秒)",
      "required": true,
      "default": 0.1,
      "widget": "number",
      "options": [],
      "description": "原声裁剪出点=对话end+padding_after"
    },
    {
      "name": "ramp_ms",
      "type": "INT",
      "label": "静音斜坡(ms)",
      "required": true,
      "default": 50,
      "widget": "number",
      "options": [],
      "description": "互斥静音淡入淡出斜坡（对齐 jy_builder ±50ms）"
    },
    {
      "name": "fade",
      "type": "FLOAT",
      "label": "原声淡入淡出(秒)",
      "required": true,
      "default": 0.1,
      "widget": "number",
      "options": [],
      "description": "OriginalAudioClip fade_in/fade_out"
    }
  ],
  "permission": {},
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "rHsiXIpZYxKfZsUG86VJ2OUThu+wxZxYhsM7AXqIyANya+IJyOf+Gtqiyva0PxYwvjmTwtm+JiM9uMuhAKh9Bg==",
    "over": "manifest"
  }
}