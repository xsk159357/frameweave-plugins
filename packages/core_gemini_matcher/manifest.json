{
  "schema_version": 2,
  "engine_api": "1.0",
  "type_id": "core/gemini_matcher",
  "title": "Gemini 语义匹配(B2)",
  "category": "语义",
  "description": "B2 专用两阶段：场景描述+解说词→LLM 语义匹配→OST 插入（独立/串联）；无 key 本地兜底；输出 matches/timeline/split_cam",
  "version": "1.0.0",
  "kind": "python",
  "runtime": "python",
  "entrypoint": "node.py",
  "class_name": "GeminiMatcherNode",
  "inputs": [
    {
      "name": "descriptions",
      "type": "JSON",
      "label": "场景描述",
      "required": false,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "场景描述：{scenes:[{id,start,end,text,dialogue}]} / split_cam 列表 / all_des.txt 文本"
    },
    {
      "name": "script",
      "type": "SCRIPT",
      "label": "解说词",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "解说词文本；支持【原片:MM:SS - MM:SS】OST 标记"
    }
  ],
  "outputs": [
    {
      "name": "matches",
      "type": "JSON",
      "label": "语义匹配",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "[{narration_index,text,scene_ids[1-3],reason,match_level,tts_duration}]"
    },
    {
      "name": "timeline",
      "type": "TIMELINE",
      "label": "时间线",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "解说时间线（match 阶段产物；含 LAY_INDEX）"
    },
    {
      "name": "split_cam",
      "type": "JSON",
      "label": "分镜(含OST)",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "分镜模型：解说段 + OST 条目（type=ost,ost=true）按 char_position 排序插入"
    },
    {
      "name": "report",
      "type": "JSON",
      "label": "执行报告",
      "required": true,
      "default": null,
      "widget": "text",
      "options": [],
      "description": "stage/match_method/llm_calls/llm_error/warnings/ost_inserted"
    }
  ],
  "params": [
    {
      "name": "stage",
      "type": "STRING",
      "label": "执行阶段",
      "required": true,
      "default": "all",
      "widget": "select",
      "options": [
        "all",
        "match",
        "ost"
      ],
      "description": "all=两阶段串联；match=仅语义匹配；ost=仅 OST 插入"
    },
    {
      "name": "api_key",
      "type": "STRING",
      "label": "API Key",
      "required": false,
      "default": "",
      "widget": "password",
      "options": [],
      "description": "支持 @secret:名称 引用保险箱；空则本地启发式兜底"
    },
    {
      "name": "base_url",
      "type": "STRING",
      "label": "API 地址",
      "required": false,
      "default": "https://ameaaos.com/v1",
      "widget": "text",
      "options": [],
      "description": "OpenAI 兼容 base（含 /v1）"
    },
    {
      "name": "model",
      "type": "STRING",
      "label": "模型",
      "required": true,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "默认 （r2 原版 gemini-2.5-flash 可覆盖）"
    },
    {
      "name": "llm_backend",
      "type": "STRING",
      "label": "LLM 后端",
      "required": true,
      "default": "llm_call",
      "widget": "select",
      "options": [
        "llm_call",
        "internal"
      ],
      "description": "llm_call=统一实现（退避[2,5,10]/回退/R1 R2）；internal=原版内嵌 urllib+重试[3,8,15] 对照"
    },
    {
      "name": "batch_size",
      "type": "INT",
      "label": "批大小(段)",
      "required": true,
      "default": 15,
      "widget": "number",
      "options": [],
      "description": "LLM 匹配每批解说词段数"
    },
    {
      "name": "cps",
      "type": "FLOAT",
      "label": "语速(字/秒)",
      "required": true,
      "default": 4.5,
      "widget": "number",
      "options": [],
      "description": "TTS 时长估算字/秒（CJK 字数 ÷ cps）"
    },
    {
      "name": "ost_max",
      "type": "FLOAT",
      "label": "OST 最长(秒)",
      "required": true,
      "default": 15.0,
      "widget": "number",
      "options": [],
      "description": "原片标记 END 钳制上限（r2 常量 MAX_OST_DURATION）"
    },
    {
      "name": "temperature",
      "type": "FLOAT",
      "label": "温度",
      "required": true,
      "default": 0.1,
      "widget": "number",
      "options": [],
      "description": "原版匹配温度 0.1"
    },
    {
      "name": "max_tokens",
      "type": "INT",
      "label": "最大 Token",
      "required": true,
      "default": 4096,
      "widget": "number",
      "options": [],
      "description": ""
    },
    {
      "name": "retries",
      "type": "INT",
      "label": "重试次数",
      "required": true,
      "default": 3,
      "widget": "number",
      "options": [],
      "description": "失败重试（llm_call 走统一退避；internal 走 [3,8,15]）"
    },
    {
      "name": "on_llm_fail",
      "type": "STRING",
      "label": "LLM 失败策略",
      "required": true,
      "default": "warn",
      "widget": "select",
      "options": [
        "warn",
        "error"
      ],
      "description": "warn=本地兜底继续（report.llm_error 记录）；error=抛错"
    },
    {
      "name": "video_path",
      "type": "STRING",
      "label": "原片路径",
      "required": false,
      "default": "",
      "widget": "text",
      "options": [],
      "description": "可选；写入 split_cam OST 条目的 source"
    }
  ],
  "permission": {
    "secret": {
      "refs": [
        "*"
      ]
    }
  },
  "signature": {
    "alg": "ed25519",
    "key_id": "a8998646b062c170",
    "value": "0cJF/680KViZKoOr0D3QpP9ZfQFEnhASalTjj3YVslbjIZh9fWqxpu+t47idVFyTzNXsHIkxKujjbQ2kOopBDQ==",
    "over": "manifest"
  }
}