{
  "id": "local_transcribe_001",
  "name": "本地转写 · 语音转字幕→样式化→片段包",
  "description": "不需要用户写文案：自动识别视频里的语音生成带时间码的字幕，套上样式，导出可交给剪辑软件的片段包与 SRT。画面不重剪，成片就是原片加字幕。模型走首启下载，全程本地。",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "本地",
    "无模型",
    "转写",
    "无文案"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/media_import",
      "x": 40,
      "y": 200,
      "params": {
        "path": "",
        "probe": true,
        "proxy_height": 0
      },
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/asr_whisper",
      "x": 300,
      "y": 200,
      "params": {
        "model": "base",
        "language": "zh",
        "vad_filter": true,
        "beam_size": 5,
        "initial_prompt": "以下是简体中文普通话。",
        "simplified": true
      },
      "inputs": {
        "audio": "n1"
      }
    },
    {
      "id": "n3",
      "type": "core/subtitle_compose",
      "x": 560,
      "y": 200,
      "params": {
        "manual_text": "",
        "preset": "默认",
        "font": "微软雅黑",
        "size": 48,
        "color": "#FFFFFF",
        "stroke": "#000000",
        "animation": "none",
        "karaoke": true
      },
      "inputs": {
        "subtitle": "n2"
      }
    },
    {
      "id": "n4",
      "type": "core/export_bundle",
      "x": 820,
      "y": 260,
      "params": {
        "output_name": "transcribe",
        "write_srt": true,
        "aspect": "16:9"
      },
      "inputs": {
        "subtitle": "n3",
        "video": "n1"
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "audio",
      "targetHandle": "audio"
    },
    {
      "source": "n2",
      "target": "n3",
      "sourceHandle": "subtitle",
      "targetHandle": "subtitle"
    },
    {
      "source": "n3",
      "target": "n4",
      "sourceHandle": "styled_subtitle",
      "targetHandle": "subtitle"
    },
    {
      "source": "n1",
      "target": "n4",
      "sourceHandle": "video",
      "targetHandle": "video"
    }
  ]
}
