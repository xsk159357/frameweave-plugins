{
  "id": "minimal",
  "name": "离线最小链 · 导入即出片",
  "description": "只依赖出厂种子节点、零 API Key、零模型下载：导入视频后按镜头直出成片（整段直出，不重剪）并导出片段包。验证平台基础链路的最小工作流。",
  "version": "2.0.0",
  "kind": "workflow",
  "tags": [
    "最小",
    "官方",
    "离线"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/media_import",
      "x": 80,
      "y": 320,
      "params": {
        "path": "",
        "probe": true,
        "proxy_height": 0
      },
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/video_render",
      "x": 400,
      "y": 320,
      "params": {
        "aspect": "16:9",
        "resolution": "1080p",
        "fps": 30,
        "burn_subtitle": false,
        "transition": "none",
        "transition_duration": 0.0,
        "scale_mode": "contain",
        "audio_mix": "original_only",
        "original_volume": 0.8,
        "overlay_alpha": 0.8,
        "align_mode": "none",
        "color_grade": "none",
        "output_name": "minimal_out"
      },
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "core/export_bundle",
      "x": 720,
      "y": 320,
      "params": {
        "name": "minimal_bundle"
      },
      "inputs": {
        "video": "n1"
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n3",
      "sourceHandle": "video",
      "targetHandle": "video"
    }
  ]
}
