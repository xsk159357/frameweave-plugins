{
  "tpl_id": "jsm_koubo",
  "name": "口播成片",
  "description": "口播视频一键出片：可选 Demucs 人声分离（伴奏作BGM）→ 场景检测（分段随机放大依据）→ 剪静音/响度/BGM/随机放大/字幕烧录 → 剪映草稿导出。直连 video 单条模式（load_video.path）；items:JSON 批次信封由 load_video.paths 提供。",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "解说猫复刻",
    "口播",
    "一键出片",
    "官方"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/load_video",
      "x": 40,
      "y": 300,
      "params": {
        "path": "",
        "paths": "",
        "copy_into_store": true,
        "probe_timeout": 30,
        "trim_start": 0.0,
        "trim_end": 0.0
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/vocal_separate",
      "x": 260,
      "y": 300,
      "params": {
        "model": "htdemucs",
        "stems": 2,
        "device": "auto",
        "python_exe": "",
        "format": "wav",
        "ffmpeg_path": ""
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "core/scene_detect",
      "x": 260,
      "y": 560,
      "params": {
        "strategy": "auto",
        "sample_fps": 1.0,
        "diff_threshold": 0.1,
        "threshold": 0.5,
        "min_duration": 1.0,
        "max_duration": 30.0,
        "merge_policy": "previous",
        "fast_mode": false,
        "transnet_model_path": ""
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n4",
      "type": "user/jsm_koubo_process",
      "x": 480,
      "y": 300,
      "params": {
        "enable_asr": false,
        "enable_trim": true,
        "trim_threshold_db": 0.0,
        "trim_min_silence_ms": 200,
        "enable_master": true,
        "master_lufs": -16.0,
        "enable_bgm": true,
        "narration_volume": 1.0,
        "bgm_volume": 0.3,
        "enable_zoom": true,
        "zoom_ratio": 0.5,
        "zoom_amount": 1.12,
        "zoom_seed": 0,
        "zoom_width": 1280,
        "subtitle_style": "经典-白字黑边",
        "enable_burn": true,
        "enable_export": true,
        "draft_name": "口播成片",
        "output_name": "koubo_out"
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "scenes": "n3",
        "bgm": "n2"
      }
    },
    {
      "id": "n5",
      "type": "core/draft_export",
      "x": 700,
      "y": 300,
      "params": {
        "format": "jianying",
        "aspect": "16:9",
        "resolution": "1080p",
        "canvas_ratio": "original",
        "draft_name": "口播成片草稿",
        "export_target": "jianying",
        "subtitle_style": "经典-白字黑边",
        "font_size": 0.0,
        "enable_subtitle": true,
        "fps": 30,
        "output_dir": "",
        "cover_original_subtitle": false
      },
      "status": "pending",
      "inputs": {
        "video": "n4",
        "segments": "n4",
        "audio": "n4"
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n3",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n4",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n3",
      "target": "n4",
      "sourceHandle": "scenes",
      "targetHandle": "scenes"
    },
    {
      "source": "n2",
      "target": "n4",
      "sourceHandle": "accompaniment",
      "targetHandle": "bgm"
    },
    {
      "source": "n4",
      "target": "n5",
      "sourceHandle": "video_out",
      "targetHandle": "video"
    },
    {
      "source": "n4",
      "target": "n5",
      "sourceHandle": "segments",
      "targetHandle": "segments"
    },
    {
      "source": "n4",
      "target": "n5",
      "sourceHandle": "audio",
      "targetHandle": "audio"
    }
  ]
}