{
  "id": "local_no_model_001",
  "name": "本地出片 · 切分→配画面→时间线→字幕→渲染成片",
  "description": "不依赖任何在线模型与 TTS：导入视频 + 输入文案，产出带时间的画面切片、样式化字幕、剪辑软件可直接用的片段包与 SRT",
  "version": "1.2.0",
  "kind": "workflow",
  "tags": [
    "本地",
    "无模型",
    "骨架"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/media_import",
      "x": 40,
      "y": 200,
      "params": {
        "path": "",
        "probe": true,
        "proxy_height": 0
      },
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/script_input",
      "x": 40,
      "y": 420,
      "params": {
        "text": "",
        "keep_empty_lines": false
      },
      "inputs": {}
    },
    {
      "id": "n3",
      "type": "core/scene_detect",
      "x": 300,
      "y": 200,
      "params": {
        "engine": "auto",
        "threshold": 0.3,
        "min_scene_sec": 1.0,
        "max_scene_sec": 12.0,
        "fallback_interval": 5.0,
        "model_dir": ""
      },
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n4",
      "type": "core/match_clip",
      "x": 560,
      "y": 300,
      "params": {
        "min_similarity": 0.2,
        "top_k": 1,
        "avoid_adjacent_repeat": true
      },
      "inputs": {
        "narration": "n2",
        "scenes": "n3"
      }
    },
    {
      "id": "n5",
      "type": "core/timeline_build",
      "x": 820,
      "y": 200,
      "params": {
        "chars_per_second": 4.5,
        "min_clip_sec": 1.0,
        "max_clip_sec": 12.0,
        "fit_mode": "truncate"
      },
      "inputs": {
        "match": "n4",
        "scenes": "n3"
      }
    },
    {
      "id": "n6",
      "type": "core/subtitle_build",
      "x": 1080,
      "y": 120,
      "params": {
        "max_chars_per_line": 16,
        "max_lines": 2,
        "min_duration": 0.5,
        "max_duration": 8.0
      },
      "inputs": {
        "timeline": "n5"
      }
    },
    {
      "id": "n7",
      "type": "core/subtitle_compose",
      "x": 1340,
      "y": 120,
      "params": {
        "manual_text": "",
        "preset": "默认",
        "font": "微软雅黑",
        "size": 48,
        "color": "#FFFFFF",
        "stroke": "#000000",
        "animation": "none",
        "karaoke": true
      },
      "inputs": {
        "subtitle": "n6"
      }
    },
    {
      "id": "n8",
      "type": "core/export_bundle",
      "x": 1600,
      "y": 260,
      "params": {
        "output_name": "bundle",
        "write_srt": true,
        "aspect": "16:9"
      },
      "inputs": {
        "timeline": "n5",
        "subtitle": "n7",
        "video": "n1"
      }
    },
    {
      "id": "n9",
      "type": "core/video_render",
      "x": 1600,
      "y": 440,
      "params": {
        "aspect": "16:9",
        "resolution": "1080p",
        "fps": 30,
        "burn_subtitle": true,
        "transition": "fade",
        "transition_duration": 0.5,
        "scale_mode": "contain",
        "audio_mix": "original_only",
        "original_volume": 0.8,
        "overlay_alpha": 0.8,
        "align_mode": "none",
        "color_grade": "none",
        "output_name": "chengpian"
      },
      "inputs": {
        "video": "n1",
        "timeline": "n5",
        "styled_subtitle": "n7"
      }
    }
  ],
  "edges": [
