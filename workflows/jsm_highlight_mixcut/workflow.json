        "canvas_ratio": "original",
        "draft_name": "高光混剪草稿",
        "export_target": "jianying",
        "subtitle_style": "经典-白字黑边",
        "font_size": 0.0,
        "enable_subtitle": false,
        "fps": 30,
        "output_dir": "",
        "cover_original_subtitle": false
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "segments": "n5",
        "timeline": "n5"
