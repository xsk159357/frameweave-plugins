        "burn_subtitle": false,
        "transition": "fade",
        "transition_duration": 0.5,
        "scale_mode": "contain",
        "audio_mix": "original_only",
        "narration_volume": 1.0,
        "original_volume": 1.0,
        "bgm_volume": 0.3,
        "overlay_alpha": 0.8,
        "align_mode": "none",
        "color_grade": "none",
        "output_name": "高光混剪成品"
