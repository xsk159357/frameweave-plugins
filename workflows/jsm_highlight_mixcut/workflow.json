      "y": 300,
      "params": {
        "mode": "story",
        "target_duration": 300.0,
        "max_clip": 50.0,
        "hook_enabled": true,
        "api_key": "@secret:llm_api_key",
        "base_url": "",
        "model": "",
        "llm_backend": "internal",
        "max_concurrent": 2,
        "retries": 1,
        "resume": true
      },
      "status": "pending",
      "inputs": {
        "scenes": "n2"
