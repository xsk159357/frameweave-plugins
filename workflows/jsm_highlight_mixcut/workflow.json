        "min_clip": 3.0,
        "max_clip": 20.0,
        "merge_gap": 1.5,
        "hook_max": 5.0,
        "hook_enabled": true,
        "scoring": "auto",
        "api_key": "@secret:llm_api_key",
        "base_url": "",
        "model": "",
        "llm_backend": "internal",
        "batch_size": 40,
        "max_concurrent": 2,
        "retries": 1,
        "resume": true
