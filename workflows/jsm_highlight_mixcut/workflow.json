        "device": "auto",
        "compute_type": "int8",
        "vad": true,
        "word_timestamps": false,
        "api_key": "",
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "remote_model": "whisper-1",
        "gemini_model": "gemini-1.5-flash",
        "window_seconds": 60.0,
        "add_roles": true,
        "enable_diarization": false,
        "diarization_model_dir": ""
