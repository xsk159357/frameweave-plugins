{
  "tpl_id": "wf_vertical_talk",
  "name": "竖屏口播字幕",
  "description": "视频导入→ASR→动态字幕→9:16 竖屏短视频",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "短视频",
    "竖屏",
    "字幕",
    "官方"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/load_video",
      "x": 30,
      "y": 300,
      "params": {
        "path": "",
        "copy_into_store": true
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/asr",
      "x": 280,
      "y": 300,
      "params": {
        "engine": "auto",
        "model": "small",
        "language": "zh",
        "device": "auto"
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "core/subtitle_compose",
      "x": 520,
      "y": 300,
      "params": {
        "preset": "知识科普",
        "animation": "typewriter",
        "karaoke": true
      },
      "status": "pending",
      "inputs": {
        "subtitle": "n2"
      },
      "input_slots": {
        "subtitle": 0
      }
    },
    {
      "id": "n4",
      "type": "core/video_render",
      "x": 780,
      "y": 300,
      "params": {
        "aspect": "9:16",
        "resolution": "1080p",
        "fps": 30,
        "burn_subtitle": true,
        "scale_mode": "fill",
        "audio_mix": "original_only",
        "output_name": "竖屏口播"
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "segments": "n5",
        "styled_subtitle": "n3"
      },
      "input_slots": {
        "segments": 0
      }
    },
    {
      "id": "n5",
      "type": "core/json_get",
      "x": 650,
      "y": 300,
      "params": {
        "path": "",
        "default": ""
      },
      "status": "pending",
      "inputs": {
        "json": "n2"
      },
      "input_slots": {
        "json": 0
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n2",
      "target": "n3",
      "sourceHandle": "subtitles",
      "targetHandle": "subtitle"
    },
    {
      "source": "n1",
      "target": "n4",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n3",
      "target": "n4",
      "sourceHandle": "styled_subtitle",
      "targetHandle": "styled_subtitle"
    },
    {
      "source": "n2",
      "target": "n5",
      "sourceHandle": "subtitles",
      "targetHandle": "json"
    },
    {
      "source": "n5",
      "target": "n4",
      "sourceHandle": "value",
      "targetHandle": "segments"
    }
  ]
}
