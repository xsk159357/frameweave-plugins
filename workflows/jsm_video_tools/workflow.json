{
  "tpl_id": "jsm_video_tools",
  "name": "视频压缩 · 转码 · 合并",
  "description": "视频工具箱三分支+合并：CRF/码率压缩、容器/编码/缩放/帧率转码、流拷贝格式转换（remux）、多视频拼接/视频音频合并（jsm_video_merge）。items:JSON 批次信封与直连 video 单条双路。",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "解说猫复刻",
    "压缩",
    "转码",
    "合并",
    "官方"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/load_video",
      "x": 40,
      "y": 300,
      "params": {
        "path": "",
        "paths": "",
        "copy_into_store": true,
        "probe_timeout": 30,
        "trim_start": 0.0,
        "trim_end": 0.0
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/video_compress",
      "x": 260,
      "y": 180,
      "params": {
        "encoder": "auto",
        "crf": 23,
        "preset": "medium",
        "max_width": 0,
        "max_height": 0,
        "fps": 0,
        "audio_bitrate": "192k",
        "hardware_accel": true,
        "remove_metadata": true,
        "output_name": "compressed"
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "user/jsm_video_transcode",
      "x": 260,
      "y": 360,
      "params": {
        "container": "mp4",
        "video_codec": "h264",
        "audio_codec": "aac",
        "crf": 23,
        "preset": "medium",
        "max_width": 0,
        "fps": 0,
        "output_name": "transcoded"
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n4",
      "type": "user/jsm_video_remux",
      "x": 260,
      "y": 540,
      "params": {
        "container": "mp4",
        "remove_metadata": true,
        "faststart": true,
        "output_name": "remuxed"
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n5",
      "type": "core/value_input",
      "x": 260,
      "y": 720,
      "params": {
        "type": "JSON",
        "value": "[{\"path\": \"\"}, {\"path\": \"\"}]"
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n6",
      "type": "user/jsm_video_merge",
      "x": 480,
      "y": 720,
      "params": {
        "mode": "concat",
        "width": 0,
        "fps": 0,
        "output_name": "merged"
      },
      "status": "pending",
      "inputs": {
        "videos": "n5"
      }
    },
    {
      "id": "n7",
      "type": "core/file_output",
      "x": 480,
      "y": 180,
      "params": {
        "filename": "compressed.json"
      },
      "status": "pending",
      "inputs": {
        "data": "n2"
      }
    },
    {
      "id": "n8",
      "type": "core/file_output",
      "x": 480,
      "y": 360,
      "params": {
        "filename": "transcoded.json"
      },
      "status": "pending",
      "inputs": {
        "data": "n3"
      }
    },
    {
      "id": "n9",
      "type": "core/file_output",
      "x": 480,
      "y": 540,
      "params": {
        "filename": "remuxed.json"
      },
      "status": "pending",
      "inputs": {
        "data": "n4"
      }
    },
    {
      "id": "n10",
      "type": "core/file_output",
      "x": 700,
      "y": 720,
      "params": {
        "filename": "merged.json"
      },
      "status": "pending",
      "inputs": {
        "data": "n6"
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n3",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n4",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n5",
      "target": "n6",
      "sourceHandle": "value",
      "targetHandle": "videos"
    },
    {
      "source": "n2",
      "target": "n7",
      "sourceHandle": "compressed",
      "targetHandle": "data"
    },
    {
      "source": "n3",
      "target": "n8",
      "sourceHandle": "transcoded",
      "targetHandle": "data"
    },
    {
      "source": "n4",
      "target": "n9",
      "sourceHandle": "formatted",
      "targetHandle": "data"
    },
    {
      "source": "n6",
      "target": "n10",
      "sourceHandle": "video_out",
      "targetHandle": "data"
    }
  ]
}