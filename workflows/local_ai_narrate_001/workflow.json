      "params": {
        "engine": "auto",
        "threshold": 0.3,
        "min_scene_sec": 1.0,
        "max_scene_sec": 12.0,
        "fallback_interval": 5.0,
        "model_dir": ""
      },
      "inputs": {
        "video": "n1"
      }
    },
    {
