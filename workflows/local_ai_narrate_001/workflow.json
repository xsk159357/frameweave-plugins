{
  "id": "local_ai_narrate_001",
  "name": "AI 写文案出片 · 切分→分块→视觉分析→写词→配音→配画面→字幕→渲染",
  "description": "给一段视频和 API Key，自动看懂画面并写出解说词，配上配音、画面与字幕，渲染成有声 MP4。",
  "version": "1.2.0",
  "kind": "workflow",
  "tags": [
    "AI",
    "解说",
    "出片",
    "需要API Key"
  ],
