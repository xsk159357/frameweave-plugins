{
  "tpl_id": "fw_bilingual",
  "name": "双语翻译配音",
  "description": "视频转字幕→多语种翻译→双语配音→成片：asr→translate→tts×2→video_render",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "翻译",
    "双语",
    "配音"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/load_video",
      "x": 40,
      "y": 320,
      "params": {
        "path": ""
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/asr",
      "x": 260,
      "y": 320,
      "params": {
        "engine": "local",
        "model": "large-v3",
        "language": "zh",
        "device": "auto"
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "core/translate",
      "x": 480,
      "y": 320,
      "params": {
        "target": "en",
        "keep_style": true,
        "base_url": "https://shouquan.frameweave.top/v1",
        "model": "gpt-4o"
      },
      "status": "pending",
      "inputs": {
        "subtitle": "n2"
      },
      "input_slots": {
        "subtitle": 0
      }
    },
    {
      "id": "n4",
      "type": "core/tts",
      "x": 700,
      "y": 160,
      "params": {
        "engine": "edge",
        "voice": "en-US-JennyNeural",
        "rate": "+0%",
        "output_format": "mp3"
      },
      "status": "pending",
      "inputs": {
        "script": "n3"
      },
      "input_slots": {
        "script": 0
      }
    },
    {
      "id": "n5",
      "type": "core/tts",
      "x": 700,
      "y": 480,
      "params": {
        "engine": "edge",
        "voice": "zh-CN-XiaoxiaoNeural",
        "rate": "+0%",
        "output_format": "mp3"
      },
      "status": "pending",
      "inputs": {
        "segments": "n8"
      },
      "input_slots": {
        "segments": 0
      }
    },
    {
      "id": "n6",
      "type": "core/subtitle_compose",
      "x": 920,
      "y": 480,
      "params": {
        "preset": "双语",
        "animation": "fade",
        "karaoke": false
      },
      "status": "pending",
      "inputs": {
        "subtitle": "n3",
        "script": "n8"
      },
      "input_slots": {
        "subtitle": 1,
        "script": 0
      }
    },
    {
      "id": "n7",
      "type": "core/video_render",
      "x": 1140,
      "y": 320,
      "params": {
        "aspect": "16:9",
        "resolution": "1080p",
        "fps": 30,
        "burn_subtitle": true,
        "audio_mix": "narration_only",
        "output_name": "双语成片"
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "segments": "n8",
        "audio": "n4",
        "styled_subtitle": "n6",
        "bgm": "n5"
      },
      "input_slots": {
        "segments": 0,
        "bgm": 0
      }
    },
    {
      "id": "n8",
      "type": "core/json_get",
      "x": 720,
      "y": 400,
      "params": {
        "path": "",
        "default": ""
      },
      "status": "pending",
      "inputs": {
        "json": "n2"
      },
      "input_slots": {
        "json": 0
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n2",
      "target": "n3",
      "sourceHandle": "subtitles",
      "targetHandle": "subtitle"
    },
    {
      "source": "n3",
      "target": "n4",
      "sourceHandle": "translated_script",
      "targetHandle": "script"
    },
    {
      "source": "n3",
      "target": "n6",
      "sourceHandle": "translated_subtitle",
      "targetHandle": "subtitle"
    },
    {
      "source": "n1",
      "target": "n7",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n4",
      "target": "n7",
      "sourceHandle": "audio",
      "targetHandle": "audio"
    },
    {
      "source": "n5",
      "target": "n7",
      "sourceHandle": "audio",
      "targetHandle": "bgm"
    },
    {
      "source": "n6",
      "target": "n7",
      "sourceHandle": "styled_subtitle",
      "targetHandle": "styled_subtitle"
    },
    {
      "source": "n2",
      "target": "n8",
      "sourceHandle": "subtitles",
      "targetHandle": "json"
    },
    {
      "source": "n8",
      "target": "n5",
      "sourceHandle": "value",
      "targetHandle": "segments"
    },
    {
      "source": "n8",
      "target": "n6",
      "sourceHandle": "value",
      "targetHandle": "script"
    },
    {
      "source": "n8",
      "target": "n7",
      "sourceHandle": "value",
      "targetHandle": "segments"
    }
  ]
}
