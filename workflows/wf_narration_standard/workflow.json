{
  "tpl_id": "wf_narration_standard",
  "name": "影视解说标准流程",
  "description": "场景分析→ASR字幕→AI解说→画面匹配→配音→字幕→16:9成片",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "影视解说",
    "标准",
    "官方"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/load_video",
      "x": 30,
      "y": 300,
      "params": {
        "path": "",
        "copy_into_store": true
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/pipeline_analyze",
      "x": 280,
      "y": 300,
      "params": {
        "scene_strategy": "auto",
        "asr_engine": "auto",
        "asr_model": "small",
        "asr_language": "zh",
        "narrate_mode": "上帝视角",
        "narrate_style": "悬疑解说",
        "narrate_language": "中文",
        "provider": "auto",
        "model": "gpt-4o",
        "target_chars": 0,
        "resume": true
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "user/jsm_match_visual",
      "x": 540,
      "y": 160,
      "params": {
        "avoid_adjacent_repeat": true,
        "embedder": "auto",
        "model_dir": "",
        "frame_positions": "0.1,0.5,0.9",
        "min_similarity": 0.2,
        "allow_reuse": true,
        "max_concurrent": 2,
        "retries": 1,
        "resume": true
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "script": "n2",
        "scenes": "n2"
      }
    },
    {
      "id": "n4",
      "type": "core/tts",
      "x": 540,
      "y": 480,
      "params": {
        "engine": "edge",
        "voice": "zh-CN-YunxiNeural",
        "rate": "+0%",
        "output_format": "mp3"
      },
      "status": "pending",
      "inputs": {
        "script": "n2"
      }
    },
    {
      "id": "n5",
      "type": "core/subtitle_compose",
      "x": 800,
      "y": 480,
      "params": {
        "preset": "悬疑惊悚",
        "animation": "fade",
        "karaoke": true
      },
      "status": "pending",
      "inputs": {
        "subtitle": "n2",
        "script": "n2"
      }
    },
    {
      "id": "n6",
      "type": "core/video_render",
      "x": 1080,
      "y": 280,
      "params": {
        "aspect": "16:9",
        "resolution": "1080p",
        "fps": 30,
        "burn_subtitle": true,
        "audio_mix": "narration_only",
        "output_name": "影视解说成片"
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "segments": "n2",
        "audio": "n4",
        "styled_subtitle": "n5"
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n3",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n2",
      "target": "n3",
      "sourceHandle": "script",
      "targetHandle": "script"
    },
    {
      "source": "n2",
      "target": "n3",
      "sourceHandle": "scenes",
      "targetHandle": "scenes"
    },
    {
      "source": "n2",
      "target": "n4",
      "sourceHandle": "script",
      "targetHandle": "script"
    },
    {
      "source": "n2",
      "target": "n5",
      "sourceHandle": "subtitles",
      "targetHandle": "subtitle"
    },
    {
      "source": "n2",
      "target": "n5",
      "sourceHandle": "script",
      "targetHandle": "script"
    },
    {
      "source": "n1",
      "target": "n6",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n2",
      "target": "n6",
      "sourceHandle": "scenes",
      "targetHandle": "segments"
    },
    {
      "source": "n4",
      "target": "n6",
      "sourceHandle": "audio",
      "targetHandle": "audio"
    },
    {
      "source": "n5",
      "target": "n6",
      "sourceHandle": "styled_subtitle",
      "targetHandle": "styled_subtitle"
    }
  ]
}
