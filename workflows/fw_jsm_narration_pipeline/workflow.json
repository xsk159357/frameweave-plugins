{
  "tpl_id": "fw_jsm_narration_pipeline",
  "name": "影视解说流水线",
  "description": "视频分析→场景/ASR→AI解说→文案画面匹配→TTS→字幕→MP4渲染→剪映/Premiere导出",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "影视解说",
    "一键出片",
    "官方"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/load_video",
      "x": 40,
      "y": 340,
      "params": {
        "path": "",
        "copy_into_store": true
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/pipeline_analyze",
      "x": 280,
      "y": 340,
      "params": {
        "scene_strategy": "auto",
        "scene_sample_fps": 1.0,
        "scene_diff_threshold": 0.1,
        "scene_min_duration": 1.0,
        "scene_max_duration": 30.0,
        "asr_engine": "auto",
        "asr_model": "small",
        "asr_language": "zh",
        "narrate_mode": "上帝视角",
        "narrate_style": "悬疑解说",
        "narrate_language": "中文",
        "provider": "auto",
        "api_key": "",
        "base_url": "https://shouquan.frameweave.top/v1",
        "model": "gpt-4o",
        "target_duration": 0,
        "target_chars": 0,
        "temperature": 0.7,
        "concurrency": 2,
        "resume": true,
        "json_mode": true,
        "local_match": true
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "user/jsm_match_visual",
      "x": 540,
      "y": 180,
      "params": {
        "avoid_adjacent_repeat": true,
        "embedder": "auto",
        "model_dir": "",
        "frame_positions": "0.1,0.5,0.9",
        "min_similarity": 0.2,
        "allow_reuse": true,
        "max_concurrent": 2,
        "retries": 1,
        "resume": true
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "script": "n2",
        "scenes": "n2"
      }
    },
    {
      "id": "n4",
      "type": "core/tts",
      "x": 540,
      "y": 500,
      "params": {
        "engine": "edge",
        "voice": "zh-CN-YunxiNeural",
        "rate": "+0%",
        "pitch": "+0Hz",
        "volume": "+0%",
        "output_format": "mp3",
        "chunk_chars": 800,
        "max_concurrent": 5,
        "retries": 3,
        "merge_audio": true
      },
      "status": "pending",
      "inputs": {
        "script": "n2"
      }
    },
    {
      "id": "n5",
      "type": "core/subtitle_compose",
      "x": 800,
      "y": 500,
      "params": {
        "preset": "悬疑惊悚",
        "animation": "fade",
        "karaoke": true
      },
      "status": "pending",
      "inputs": {
        "subtitle": "n2",
        "script": "n2"
      }
    },
    {
      "id": "n6",
      "type": "core/video_render",
      "x": 1060,
      "y": 260,
      "params": {
        "aspect": "16:9",
        "resolution": "1080p",
        "fps": 30,
        "burn_subtitle": true,
        "transition": "fade",
        "audio_mix": "narration_only",
        "narration_volume": 1.0,
        "original_volume": 0.35,
        "bgm_volume": 0.3,
        "output_name": "解说猫复刻成片"
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "segments": "n2",
        "audio": "n4",
        "styled_subtitle": "n5"
      }
    },
    {
      "id": "n7",
      "type": "core/draft_export",
      "x": 1060,
      "y": 560,
      "params": {
        "format": "all",
        "aspect": "16:9",
        "resolution": "1080p",
        "draft_name": "解说猫复刻导出",
        "export_target": "jianying",
        "enable_subtitle": true,
        "fps": 30,
        "output_dir": ""
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "segments": "n2",
        "audio": "n4",
        "styled_subtitle": "n5",
        "timeline": "n3"
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n3",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n2",
      "target": "n3",
      "sourceHandle": "script",
      "targetHandle": "script"
    },
    {
      "source": "n2",
      "target": "n3",
      "sourceHandle": "scenes",
      "targetHandle": "scenes"
    },
    {
      "source": "n2",
      "target": "n4",
      "sourceHandle": "script",
      "targetHandle": "script"
    },
    {
      "source": "n2",
      "target": "n5",
      "sourceHandle": "subtitles",
      "targetHandle": "subtitle"
    },
    {
      "source": "n2",
      "target": "n5",
      "sourceHandle": "script",
      "targetHandle": "script"
    },
    {
      "source": "n1",
      "target": "n6",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n2",
      "target": "n6",
      "sourceHandle": "scenes",
      "targetHandle": "segments"
    },
    {
      "source": "n4",
      "target": "n6",
      "sourceHandle": "audio",
      "targetHandle": "audio"
    },
    {
      "source": "n5",
      "target": "n6",
      "sourceHandle": "styled_subtitle",
      "targetHandle": "styled_subtitle"
    },
    {
      "source": "n1",
      "target": "n7",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n2",
      "target": "n7",
      "sourceHandle": "scenes",
      "targetHandle": "segments"
    },
    {
      "source": "n4",
      "target": "n7",
      "sourceHandle": "audio",
      "targetHandle": "audio"
    },
    {
      "source": "n5",
      "target": "n7",
      "sourceHandle": "styled_subtitle",
      "targetHandle": "styled_subtitle"
    },
    {
      "source": "n3",
      "target": "n7",
      "sourceHandle": "timeline",
      "targetHandle": "timeline"
    }
  ]
}
