{
  "tpl_id": "wf_highlight_mix",
  "name": "剧情高光混剪",
  "description": "场景检测→ASR→精彩片段评分→高光混剪→竖屏输出",
  "version": "1.0.0",
  "kind": "workflow",
  "tags": [
    "影视解说",
    "高光",
    "混剪",
    "官方"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "core/load_video",
      "x": 30,
      "y": 300,
      "params": {
        "path": "",
        "copy_into_store": true
      },
      "status": "pending",
      "inputs": {}
    },
    {
      "id": "n2",
      "type": "core/scene_detect",
      "x": 260,
      "y": 300,
      "params": {
        "sample_fps": 1,
        "threshold": 0.12,
        "min_duration": 0.8
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n3",
      "type": "core/asr",
      "x": 480,
      "y": 180,
      "params": {
        "engine": "auto",
        "model": "small",
        "language": "zh",
        "device": "auto"
      },
      "status": "pending",
      "inputs": {
        "video": "n1"
      }
    },
    {
      "id": "n4",
      "type": "user/jsm_highlight_mixcut",
      "x": 700,
      "y": 300,
      "params": {
        "target_seconds": 60,
        "min_clip": 2,
        "max_clip": 7,
        "hook_enabled": true,
        "scoring": "ai"
      },
      "status": "pending",
      "inputs": {
        "items": "n3"
      }
    },
    {
      "id": "n5",
      "type": "core/video_render",
      "x": 980,
      "y": 300,
      "params": {
        "aspect": "9:16",
        "resolution": "1080p",
        "fps": 30,
        "burn_subtitle": false,
        "audio_mix": "original_only",
        "output_name": "高光混剪"
      },
      "status": "pending",
      "inputs": {
        "video": "n1",
        "segments": "n4"
      }
    }
  ],
  "edges": [
    {
      "source": "n1",
      "target": "n2",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n1",
      "target": "n3",
      "sourceHandle": "video",
      "targetHandle": "video"
    },
    {
      "source": "n3",
      "target": "n4",
      "sourceHandle": "subtitles",
      "targetHandle": "rows"
    },
    {
      "source": "n4",
      "target": "n5",
      "sourceHandle": "segments",
      "targetHandle": "segments"
    },
    {
      "source": "n1",
      "target": "n5",
      "sourceHandle": "video",
      "targetHandle": "video"
    }
  ]
}
